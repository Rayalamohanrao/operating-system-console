
#include <stdio.h>

#define MAX 20

int main() {
    int choice, n, i, j;
    int pid[MAX], bt[MAX], wt[MAX], tat[MAX];
    int memory[MAX], blockSize, processSize;
    int totalWT, totalTAT, temp;

    do {
        printf("\n===== OPERATING SYSTEM SIMULATION =====\n");
        printf("1. Process Management\n");
        printf("2. CPU Scheduling (FCFS)\n");
        printf("3. Memory Management\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter number of processes (max %d): ", MAX);
                scanf("%d", &n);

                if (n < 1 || n > MAX) {
                    printf("Invalid number of processes!\n");
                    break;
                }

                for (i = 0; i < n; i++) {
                    pid[i] = i + 1;
                    printf("Process P%d created.\n", pid[i]);
                }
                break;

            case 2:
                printf("Enter number of processes (max %d): ", MAX);
                scanf("%d", &n);

                if (n < 1 || n > MAX) {
                    printf("Invalid number of processes!\n");
                    break;
                }

                for (i = 0; i < n; i++) {
                    printf("Enter burst time for P%d: ", i + 1);
                    scanf("%d", &bt[i]);

                    if (bt[i] < 0) {
                        printf("Burst time cannot be negative.\n");
                        i--;
                    }
                }

                wt[0] = 0;
                for (i = 1; i < n; i++) {
                    wt[i] = wt[i - 1] + bt[i - 1];
                }

                totalWT = 0;
                totalTAT = 0;

                printf("\nProcess\tBurst\tWaiting\tTurnaround\n");

                for (i = 0; i < n; i++) {
                    tat[i] = wt[i] + bt[i];
                    totalWT += wt[i];
                    totalTAT += tat[i];

                    printf("P%d\t%d\t%d\t%d\n",
                           i + 1, bt[i], wt[i], tat[i]);
                }

                printf("Average Waiting Time = %.2f\n",
                       (float)totalWT / n);
                printf("Average Turnaround Time = %.2f\n",
                       (float)totalTAT / n);
                break;

            case 3:
                printf("Enter number of memory blocks (max %d): ", MAX);
                scanf("%d", &n);

                if (n < 1 || n > MAX) {
                    printf("Invalid number of blocks!\n");
                    break;
                }

                for (i = 0; i < n; i++) {
                    printf("Enter size of memory block %d: ", i + 1);
                    scanf("%d", &memory[i]);
                }

                printf("Enter process size: ");
                scanf("%d", &processSize);

                if (processSize <= 0) {
                    printf("Invalid process size!\n");
                    break;
                }

                for (i = 0; i < n; i++) {
                    if (memory[i] >= processSize) {
                        printf("Process allocated to block %d.\n", i + 1);
                        printf("Internal fragmentation = %d\n",
                               memory[i] - processSize);
                        break;
                    }
                }

                if (i == n) {
                    printf("Memory allocation failed!\n");
                }
                break;

            case 4:
                printf("Exiting Operating System Simulation.\n");
                break;

            default:
                printf("Invalid choice! Try again.\n");
        }

    } while (choice != 4);

    return 0;
}
